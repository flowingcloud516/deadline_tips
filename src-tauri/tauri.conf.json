{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadline Tips",
  "version": "0.1.0",
  "identifier": "com.deadlinetips.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Deadline Tips",
        "width": 480,
        "height": 430,
        "minWidth": 360,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "manager",
        "title": "Deadline Tips - 任务管理",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
